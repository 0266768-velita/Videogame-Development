--- !u!114 &919482099
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919482096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae6d0f49fbfcabe459cb02d659fcf0de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.DialogueNPC
  npcName: Citlali, the widow
  id: citlali
  firstTalk:
  - I light candles for my husband. The witches took him to the crooked house in
    the west.
  - "They are the Cihuateteo, women who died giving life. Mictl\xE1n took their names,
    and now they steal from those who still have one."
  - Four of them. Four lights. They never leave him alone... you would have to face
    all four at once.
  - If you go... look at the walls. They always paint what they steal.
  laterTalk:
  - Four lights in the west. They paint what they steal. Remember that.
  body: {fileID: 899783108}
  portrait: {fileID: 0}
  playerPortrait: {fileID: 1739314709, guid: 1622c75d16ce15649ae8d1e06ce707f8, type: 3}
  sign: {fileID: 135402007}
  newSign: {fileID: 21300000, guid: 00d8b4e619285ad438ba5699ac7ae674, type: 3}
  talkedSign: {fileID: 21300000, guid: 27e2d5cfaf6daa146a0750d167006ea9, type: 3}
  idleBob: 1
