--- !u!114 &2128143638
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2128143635}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae6d0f49fbfcabe459cb02d659fcf0de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.DialogueNPC
  npcName: Xochitl, the boatwoman
  id: xochitl
  firstTalk:
  - "Careful by the water, young one. The river of Mictl\xE1n does not carry boats
    any more, only the careless."
  - My boat sank long ago. Now I watch the crossings. Where the river is narrow,
    the brave JUMP. Sprint first, then leap.
  - If you fall in, the river spits you back where you last stood on firm ground.
    It takes a little of your strength as payment.
  - There are bridges too. Look for the planks, or for flat stones in a line across
    the water.
  laterTalk:
  - 'Narrow water: sprint, then jump. Wide water: find a bridge. That is all the
    wisdom an old boatwoman has.'
  body: {fileID: 1595255386}
  portrait: {fileID: 0}
  playerPortrait: {fileID: 1739314709, guid: 1622c75d16ce15649ae8d1e06ce707f8, type: 3}
  sign: {fileID: 138403696}
  newSign: {fileID: 21300000, guid: 00d8b4e619285ad438ba5699ac7ae674, type: 3}
  talkedSign: {fileID: 21300000, guid: 27e2d5cfaf6daa146a0750d167006ea9, type: 3}
  idleBob: 1
