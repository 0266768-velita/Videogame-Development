  m_Script: {fileID: 11500000, guid: 6de4e375849a436409ddfdb77e548917, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.InteractSpot
  prompt: '{Interact}  Read the glyphs of the shrine'
  speaker: Glyphs of the shrine
  lines:
  - "Here the Feathered Serpent came down to Mictl\xC3\xA1n to steal the bones of
    the dead and make the people of this age."
  - "The serpent's door is sealed. The House of the Wind, where Quetzalc\xC3\xB3atl
    sleeps, lies to the east: a black temple with obsidian gates."
  - Only the obsidian key opens them. It is born when every servant of the gods has
    fallen.
  - '> So the way forward is east... once the last of them is gone.'
  portrait: {fileID: 0}
