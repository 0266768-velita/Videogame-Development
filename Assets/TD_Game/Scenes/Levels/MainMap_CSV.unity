  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.DialogueNPC
  npcName: A xoloitzcuintle
  id: xolo
  firstTalk:
  - Woof!
  - '> The dog looks at the river, then at me... then at the river again.'
  - '> There are flat stones in the water. A line of them. Maybe I could jump from
    one to the next.'
  laterTalk:
  - Woof! Woof!
  - '> He wags his tail at the stones in the river.'
