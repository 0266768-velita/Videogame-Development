  m_Script: {fileID: 11500000, guid: 6de4e375849a436409ddfdb77e548917, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.InteractSpot
  prompt: '{Interact}  Read the glyphs of the shrine'
  speaker: Glyphs of the shrine
  lines:
  - "Here the Feathered Serpent came down to Mictl\xE1n to steal the bones of the
    dead and make the people of this age."
  - "The serpent's mouth leads down into the House of the Wind, where Quetzalc\xF3atl
    sleeps behind a gate of obsidian."
  - Only the obsidian key opens it. It is born when every servant of the gods has
    fallen.
  - '> So I go in through the serpent''s mouth... once the last of them is gone.'
  portrait: {fileID: 0}
