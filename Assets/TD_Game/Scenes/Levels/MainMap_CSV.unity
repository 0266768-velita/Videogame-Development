  m_Script: {fileID: 11500000, guid: 72eadc74850750f459676b11c411450e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.DefeatScreen
  panel: {fileID: 1468972782}
  tipText: {fileID: 533174660}
  retryButton: {fileID: 807681697}
  menuButton: {fileID: 1696554203}
  mainMenuScene: MainMenu
  fadeTime: 0.6
  inputDelay: 1
  tips:
  - 'Wait for the last moment to dodge: a PERFECT dodge gives stamina, Tonalli and
    a counter-attack.'
  - Spells cannot be dodged. Interrupt them with 1.
  - 'Ending your turn with stamina left is fine: you recover part of it every turn.'
  - Jump onto an enemy before the battle to AMBUSH it and act first.
  - Green orbs heal you. Collect them before the next fight.
  - The Giant's quake cannot be dodged. Keep your health high before it charges.
  - "Quetzalc\xF3atl changes form at half health. Save your Tonalli Burst for that
    moment."
