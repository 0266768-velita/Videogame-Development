--- !u!114 &583358599
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 583358597}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 165d981cad93a8f46b0acada18e16039, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.MerchantShop
  merchantName: "MERCHANT OF MICTL\xC1N"
  potionPrice: 40
  smallBet: 15
  bigBet: 40
  winChance: 0.4
  artifactPrice: 200
  artifact: {fileID: 11400000, guid: 7acc762dcbac3164fb95e3980f536b96, type: 2}
  greetLines:
  - text: What do you want, stranger?
    clip: {fileID: 8300000, guid: bd2df7dacf1137540a20616ab800d3fb, type: 3}
  - text: Ahh... a living soul. Come closer, stranger.
    clip: {fileID: 8300000, guid: ab3c65d6e5cdb8441b6cfe84e3df087a, type: 3}
  - text: Got some fine things for sale, warrior. Take a look.
    clip: {fileID: 8300000, guid: 6a868aba4bc828e4b807ed58ff669183, type: 3}
  - text: Welcome, welcome! Mind the bones on the floor.
    clip: {fileID: 8300000, guid: 997db16b83969a64d9b8d7d4c81f13b6, type: 3}
  buyLines:
  - text: Heh heh... a fine choice.
    clip: {fileID: 8300000, guid: e7cd17ccd9b7ec947b360df4b99688ec, type: 3}
  - text: Pleasure doing business, stranger.
    clip: {fileID: 8300000, guid: 333e0149359475749b2e307993fd60d2, type: 3}
  - text: That will serve you well down there.
    clip: {fileID: 8300000, guid: 0d1d9ca594201214f969a37a3a0aaedd, type: 3}
  - text: Sold! Try not to die before you use it.
    clip: {fileID: 8300000, guid: dbeb3f5357571de409e23c4c4e847fd5, type: 3}
  winLines:
  - text: Ohh! The gods smile on you today, stranger!
    clip: {fileID: 8300000, guid: 14b7d088f82f83643875727ed7edd84f, type: 3}
  - text: Lucky bones... Take your gold.
    clip: {fileID: 8300000, guid: 6a3ad6a9335066c4d8d9fef01bccec25, type: 3}
  - text: Bah! Fortune is a fickle thing. You win.
    clip: {fileID: 8300000, guid: 9713aa1c1f2658e41b469e7ae93a3530, type: 3}
  loseLines:
  - text: Heh heh heh... the bones have spoken.
    clip: {fileID: 8300000, guid: 8642bb6966f495d46a5e02e7aa5e7029, type: 3}
  - text: The house of the dead always wins, stranger.
    clip: {fileID: 8300000, guid: 339464205976b6a48a63923e57f3cfd1, type: 3}
  - text: Better luck in your next life.
    clip: {fileID: 8300000, guid: c527730101375a341a86a5803fc98706, type: 3}
  goodbyeLines:
  - text: Come back anytime... if you're still breathing.
    clip: {fileID: 8300000, guid: 9042070ae853bc74c8ac95feb9c272c4, type: 3}
  - text: Watch your back out there, stranger.
    clip: {fileID: 8300000, guid: a428628d3c21d644dbdbbe17a3c40981, type: 3}
  voicePitch: 0.94
  previewFrames:
  - {fileID: 1739314709, guid: 1622c75d16ce15649ae8d1e06ce707f8, type: 3}
  - {fileID: -111851017, guid: 1622c75d16ce15649ae8d1e06ce707f8, type: 3}
  - {fileID: -99243604, guid: 1622c75d16ce15649ae8d1e06ce707f8, type: 3}
  - {fileID: 696257156, guid: 1622c75d16ce15649ae8d1e06ce707f8, type: 3}
  promptText: {fileID: 1411779399}
  menuFont: {fileID: 12800000, guid: 366cbbd1481eb254a8fe21a009ddf558, type: 3}
