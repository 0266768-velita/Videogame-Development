--- !u!114 &2131605900
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2131605899}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 287d19d24d6a2d647a5919d148c3e6d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TD_Game.PrologueComic
  menuFont: {fileID: 12800000, guid: 366cbbd1481eb254a8fe21a009ddf558, type: 3}
  pages:
  - panels:
    - picture: {fileID: 2800000, guid: 6ffede1609ef3f34f9b1639614295b77, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: 'Teotihuacan, 1430.

        At the height of the Mexica world...'
    - picture: {fileID: 2800000, guid: 917d88825aec2fe4e935e44cff8026d2, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: 'His mother was dying.

        They were all each other had.'
    - picture: {fileID: 2800000, guid: 4880dbd5e24d1474db2dbe5351dd0334, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: Tlahuelli could only watch over her.
  - panels:
    - picture: {fileID: 2800000, guid: 543dec09efd44e34090e8d9cd1e49aa1, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: 'He danced for the gods,

        begging them to hear him.'
    - picture: {fileID: 2800000, guid: 91416f2afb6e6024a9256aeedb281daf, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: They did not answer.
    - picture: {fileID: 2800000, guid: c7768aacc4a8fd7479b8fb4a89da1076, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: That night, grief became something else.
  - panels:
    - picture: {fileID: 2800000, guid: 474048520bd83d1418fa9780fbee839d, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: '"I will make them answer."'
  - panels:
    - picture: {fileID: 2800000, guid: fb095de9ec4aba647858324546d7293e, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: 'MICTLANTECUHTLI:

        "The gods forgot you.

        They forgot
        me too."'
    - picture: {fileID: 2800000, guid: e32d0882d02eb274384d370dafd0b6e1, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 0.8, g: 0.8, b: 0.85, a: 1}
      caption: '"Take this Macuahuitl. It grows hungry with every servant of the
        gods you strike down."'
    - picture: {fileID: 2800000, guid: 2332ad1e3a0ec3a43bccf3b1121d32fb, type: 3}
      crop:
        serializedVersion: 2
        x: 0
        y: 0
        width: 1
        height: 1
      tint: {r: 1, g: 1, b: 1, a: 1}
      caption: And so his journey began.
  nextScene: MainMap
